# ==============================================================================
# Giftlist Wishlist Maker - Server Configuration & Affiliate Programs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Store Affiliate Programs (All Six Stores)
# ------------------------------------------------------------------------------
# Global killswitch: Set to true to disable affiliate tagging across all stores
DISABLE_ALL_AFFILIATES=false

# Store 1: Amazon Associates
# Set your associate tag (e.g. yourtag-20). If empty, Amazon URLs are served clean without affiliate tagging.
AMAZON_ASSOCIATE_TAG=
AFFILIATE_ENABLED_AMAZON=true

# Store 2: eBay Partner Network (EPN)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
AFFILIATE_ENABLED_EBAY=false

# Store 3: Walmart Creator / Impact Radius
WALMART_AFFILIATE_TAG=
AFFILIATE_ENABLED_WALMART=false

# Store 4: Target Partners / Impact
TARGET_AFFILIATE_TAG=
AFFILIATE_ENABLED_TARGET=false

# Store 5: Best Buy Affiliate / Impact / Rakuten
BESTBUY_AFFILIATE_TAG=
AFFILIATE_ENABLED_BESTBUY=false

# Store 6: Etsy Affiliate / Awin
ETSY_AWIN_TAG=
AFFILIATE_ENABLED_ETSY=false

# ------------------------------------------------------------------------------
# 2. Manual Affiliate Overrides (JSON string)
# ------------------------------------------------------------------------------
# Paste specific manual affiliate links by ASIN, item ID, or product URL:
# Example: '{"B08N5WRWNW":"https://amzn.to/3example","123456789":"https://ebay.to/example"}'
MANUAL_AFFILIATE_OVERRIDES=

# ------------------------------------------------------------------------------
# 3. Optional Paid Scraper Fallbacks (Disabled by default)
# ------------------------------------------------------------------------------
CRAWLBASE_TOKEN=
SCRAPFLY_KEY=
